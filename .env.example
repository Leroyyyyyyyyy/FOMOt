# ── Telegram ──────────────────────────────────────────────
# 找 @BotFather 建 bot 拿 token；把 bot 拉进你的频道并设为管理员
TELEGRAM_BOT_TOKEN=
# 频道用 @channelname 或 -100 开头的数字 id
TELEGRAM_CHAT_ID=

# ── Robinhood Chain (chainId 4663，已实测) ─────────────────
# 逗号分隔，按优先级排列；前面的报错才降级到后面。留空用内置默认（主 + blockmachine 备用）。
# 别按延迟排序——低延迟节点不一定数据全，实测有些只服务最近 20 个区块。
RPC_URLS=https://rpc.mainnet.chain.robinhood.com,https://rpc-robinhood.blockmachine.io
BLOCKSCOUT_URL=https://robinhoodchain.blockscout.com

# ── FOMO 抓取 ─────────────────────────────────────────────
# 首次跑 `npm run login` 会开一个有头浏览器让你手动登录，
# 会话存到 data/fomo-session/，之后都用 headless 复用。
FOMO_HEADLESS=true

LOG_LEVEL=info
TZ=Asia/Hong_Kong
