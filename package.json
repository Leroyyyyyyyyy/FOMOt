{
  "name": "fomot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "login": "tsx src/fomo/login.ts",
    "check-session": "tsx scripts/check-session.ts",
    "check-telegram": "tsx scripts/check-telegram.ts",
    "discover": "tsx scripts/discover.ts",
    "status": "tsx scripts/status.ts",
    "diagnose": "tsx scripts/diagnose.ts",
    "probe-rpcs": "tsx scripts/probe-rpcs.ts",
    "explain": "tsx scripts/explain.ts",
    "check-rules": "tsx scripts/check-rules.ts",
    "backtest": "tsx scripts/backtest-samples.ts",
    "dry-run": "NOTIFY_MODE=off tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "dry-run:relaxed": "NOTIFY_MODE=off RULES_FILE=config/rules.test.yaml tsx src/index.ts",
    "report": "tsx scripts/run-report.ts",
    "post:probe": "tsx scripts/post-probe.ts",
    "post:check-config": "tsx scripts/post-check-config.ts",
    "post:import": "tsx scripts/post-import.ts",
    "post:dry-run": "STRATEGY_MODE=post_v1 NOTIFY_MODE=off tsx src/index.ts",
    "post:explain": "tsx scripts/post-explain.ts",
    "post:replay": "tsx scripts/post-replay.ts",
    "post:report": "tsx scripts/post-report.ts"
  },
  "dependencies": {
    "dotenv": "^17.2.3",
    "pino": "^9.13.1",
    "pino-pretty": "^13.1.2",
    "playwright": "^1.56.1",
    "viem": "^2.39.3",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "tsx": "^4.20.7",
    "typescript": "^5.9.3"
  }
}
